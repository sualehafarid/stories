    {
      "cell_type": "markdown",
      "source": [
        "#### Features Based on Feedback"
      ],
      "metadata": {
        "id": "W_2s0nfDzSNo"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "def speculativeness(text):\n",
        "    doc = nlp(text)\n",
        "    modal_like = [tok for tok in doc if tok.tag_ in [\"MD\"] or tok.dep_ in [\"advcl\", \"ccomp\"]]\n",
        "    return len(modal_like) / len(doc)\n",
        "\n",
        "df[\"speculativeness\"] = df[\"story_clean\"].apply(speculativeness)"
      ],
      "metadata": {
        "id": "Kbv846-0vcHG"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def emotional_expressivity(text):\n",
        "    emotion_scores = NRCLex(text).raw_emotion_scores\n",
        "    n_tokens = len(nltk.word_tokenize(text))\n",
        "    n_emotions = len(emotion_scores)\n",
        "    total_emotion_words = sum(emotion_scores.values())\n",
        "    intensity = total_emotion_words / (n_tokens or 1)\n",
        "    return n_emotions, intensity\n",
        "\n",
        "df[\"n_emotions\"], df[\"emotion_intensity\"] = zip(*df[\"story_clean\"].map(emotional_expressivity))"
      ],
      "metadata": {
        "id": "m7iA_3ayvine"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def syntactic_complexity(text):\n",
        "    doc = nlp(text)\n",
        "    depths = [len([tok for tok in sent if tok.dep_ in [\"advcl\", \"ccomp\", \"relcl\"]]) for sent in doc.sents]\n",
        "    return sum(depths)/len(list(doc.sents))\n",
        "\n",
        "df[\"syntactic_complexity\"] = df[\"story_clean\"].apply(syntactic_complexity)"
      ],
      "metadata": {
        "id": "HD2WwBvWxHbV"
      },
      "execution_count": null,
      "outputs": []
    },
