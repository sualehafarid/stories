    {
      "cell_type": "markdown",
      "source": [
        "#### Testing models using updated feature set"
      ],
      "metadata": {
        "id": "Sw3BDcSfiW4F"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "##### Features set up"
      ],
      "metadata": {
        "id": "OwfTdNq8llD7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "df = pd.read_csv(\"eval_complete.csv\", engine=\"python\")\n"
      ],
      "metadata": {
        "id": "_GExcs9z2pp8"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "cp1features = [\"modal\",\"modal_rate\",\"first_person_rate\",\"third_person_rate\",\"sentiment\",\"subjectivity\"]\n",
        "cp2features = [\"concreteness_mean\", \"narrative_flow\", \"realis_density\",\"commonsense_density\", \"event_density\", \"speculativeness\", \"n_emotions\", \"emotion_intensity\", \"syntactic_complexity\"]\n",
        "combined_feats = cp1features + cp2features"
      ],
      "metadata": {
        "id": "kTDerjkHjitf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "use_feats = combined_feats\n",
        "print(f\"Using {len(use_feats)} features:\", use_feats)\n",
        "\n",
        "# set up data\n",
        "X = df[use_feats].copy()\n",
        "y = (df[\"label\"].astype(str).str.lower() == \"human\").astype(int)\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.3, random_state=42, stratify=y\n",
        ")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "0bvKmzfpoak3",
        "outputId": "09790490-e5d2-4596-bffc-3b0e765958e7"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Using 15 features: ['modal', 'modal_rate', 'first_person_rate', 'third_person_rate', 'sentiment', 'subjectivity', 'concreteness_mean', 'narrative_flow', 'realis_density', 'commonsense_density', 'event_density', 'speculativeness', 'n_emotions', 'emotion_intensity', 'syntactic_complexity']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#### Stat Test"
      ],
      "metadata": {
        "id": "eLjmrg6A15eF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "results = []\n",
        "df_wp = df.copy()\n",
        "\n",
        "# binary target for WP dataset\n",
        "df_wp[\"label_bin\"] = (df_wp[\"label\"].str.lower() == \"gpt3.5\").astype(int)\n",
        "\n",
        "for feat in use_feats:\n",
        "    gpt_vals = df_wp[df_wp[\"label_bin\"] == 1][feat].dropna()\n",
        "    hum_vals = df_wp[df_wp[\"label_bin\"] == 0][feat].dropna()\n",
        "\n",
        "    # Mann-Whitney U test (non-parametric)\n",
        "    u, p = stats.mannwhitneyu(gpt_vals, hum_vals, alternative=\"two-sided\")\n",
        "\n",
        "    results.append({\n",
        "        \"feature\": feat,\n",
        "        \"mean_gpt\": gpt_vals.mean(),\n",
        "        \"mean_human\": hum_vals.mean(),\n",
        "        \"u_statistic\": u,\n",
        "        \"p_value\": p\n",
        "    })\n",
        "\n",
        "df_stats = pd.DataFrame(results).sort_values(\"p_value\")\n",
        "df_stats\n"
      ],
