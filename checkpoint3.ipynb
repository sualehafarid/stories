      "source": [
        "import json\n",
        "from huggingface_hub import hf_hub_download\n",
        "\n",
        "repo_id = \"vkpriya/GPT-WritingPrompts\"\n",
        "\n",
        "gpt_path = hf_hub_download(repo_id, \"gpt_wp_stories.json\", repo_type=\"dataset\")\n",
        "human_path = hf_hub_download(repo_id, \"human_wp_stories.json\", repo_type=\"dataset\")\n",
        "\n",
        "with open(gpt_path, \"r\", encoding=\"utf-8\") as f:\n",
        "    gpt_json = json.load(f)\n",
        "\n",
        "with open(human_path, \"r\", encoding=\"utf-8\") as f:\n",
        "    human_json = json.load(f)\n"
