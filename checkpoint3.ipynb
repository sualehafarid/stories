        "\n",
        "# run one feature at a time to see impact of each\n",
        "\n",
        "for feat in use_feats:\n",
        "    Xf = X[[feat]]\n",
        "    X_train_f, X_test_f, y_train_f, y_test_f = train_test_split(\n",
        "        Xf, y, test_size=0.3, random_state=42\n",
        "    )\n",
        "    pipe_f = Pipeline([\n",
        "        (\"scaler\", StandardScaler()),\n",
        "        (\"clf\", LogisticRegression(max_iter=1000))\n",
        "    ])\n",
        "    pipe_f.fit(X_train_f, y_train_f)\n",
        "    y_proba_f = pipe_f.predict_proba(X_test_f)[:, 1]\n",
        "    auc = roc_auc_score(y_test_f, y_proba_f)\n",
        "    print(f\"{feat}: AUC = {auc:.3f}\")\n"
