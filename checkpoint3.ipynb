      "source": [
        "# put eval data in format where we have stories for each prompt in same row by humans and llms\n",
        "# dataset has lists of stories for each prompt but i only need one but human and one by gpt for each prompt so extracting just the first\n",
        "\n",
        "rows = []\n",
        "\n",
        "for prompt, human_stories in human_json.items():\n",
        "    if prompt in gpt_json:\n",
        "        gpt_stories = gpt_json[prompt]\n",
        "\n",
        "        # ensure lists are non-empty\n",
        "        if len(human_stories) > 0 and len(gpt_stories) > 0:\n",
        "            rows.append({\n",
        "                \"prompt\": prompt,\n",
        "                \"human_story\": human_stories[0],  # first human story\n",
        "                \"gpt_story\": gpt_stories[0]       # first gpt story\n",
        "            })\n",
        "\n",
        "df_readable = pd.DataFrame(rows)\n",
        "df_readable.head()"
      ],
