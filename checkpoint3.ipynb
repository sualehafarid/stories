        "# Bar Plots\n",
        "\n",
        "fig, axes = plt.subplots(\n",
        "    nrows=int(np.ceil(len(use_feats)/3)), ncols=3,\n",
        "    figsize=(15, 4 * int(np.ceil(len(use_feats)/3)))\n",
        ")\n",
        "\n",
        "axes = axes.flatten()\n",
        "\n",
        "for i, feat in enumerate(use_feats):\n",
        "    ax = axes[i]\n",
        "\n",
        "    gpt_vals = df_wp[df_wp[\"label_bin\"] == 1][feat].dropna()\n",
        "    hum_vals = df_wp[df_wp[\"label_bin\"] == 0][feat].dropna()\n",
        "\n",
        "    # Mann-Whitney U test for display\n",
        "    U, p = stats.mannwhitneyu(gpt_vals, hum_vals, alternative=\"two-sided\")\n",
        "\n",
        "    means = [hum_vals.mean(), gpt_vals.mean()]\n",
        "    sems =  [stats.sem(hum_vals), stats.sem(gpt_vals)]\n",
        "    labels = [\"Human\", \"GPT\"]\n",
        "    colors = [\"#4C72B0\", \"#55A868\"]\n",
        "\n",
        "    ax.bar(labels, means, yerr=sems, capsize=5, color=colors)\n",
        "    ax.set_title(f\"{feat}\\np={p:.3e}\", fontsize=12)\n",
        "    ax.set_ylabel(\"Value\")\n",
        "\n",
        "# Remove any empty subplots\n",
        "for j in range(i+1, len(axes)):\n",
        "    fig.delaxes(axes[j])\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
