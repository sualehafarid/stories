    {
      "cell_type": "code",
      "source": [
        "# Prepare WritingPrompts data - train\n",
        "\n",
        "df_wp[\"label_bin\"] = (df_wp[\"label\"].str.lower() == \"gpt3.5\").astype(int)\n",
        "\n",
        "X_train = df_wp[use_feats]\n",
        "y_train = df_wp[\"label_bin\"]\n",
        "\n",
        "# Prepare Hippocorpus data - test\n",
        "\n",
        "df_hippo[\"label_bin\"] = (df_hippo[\"memType\"].str.lower() == \"imagined\").astype(int)\n",
        "\n",
        "X_test = df_hippo[use_feats]\n",
        "y_test = df_hippo[\"label_bin\"]\n",
        "\n",
        "# pipeline\n",
        "pipe = Pipeline([\n",
        "    (\"scaler\", StandardScaler()),\n",
        "    (\"clf\", LogisticRegression(max_iter=1000, random_state=42))\n",
        "])\n",
        "\n",
        "pipe.fit(X_train, y_train)\n",
        "\n",
        "# test on hippocorpus\n",
        "y_pred = pipe.predict(X_test)\n",
        "y_proba = pipe.predict_proba(X_test)[:, 1]\n",
        "\n",
        "# show results\n",
        "acc = accuracy_score(y_test, y_pred)\n",
        "f1 = f1_score(y_test, y_pred)\n",
        "auc = roc_auc_score(y_test, y_proba)\n",
        "\n",
        "print(\"Zero-Shot Test: WritingPrompts to Hippocorpus\")\n",
        "print(f\"Accuracy: {acc:.3f}\")\n",
        "print(f\"F1 Score: {f1:.3f}\")\n",
        "print(f\"AUC:      {auc:.3f}\")\n",
        "\n",
        "RocCurveDisplay.from_predictions(y_test, y_proba)\n",
        "plt.title(\"ROC: WP-trained model tested on Hippocorpus\")\n",
        "plt.show()\n"
