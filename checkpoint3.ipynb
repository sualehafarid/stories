        "### Creating features for eval dataset\n",
        "Doing so in the same way as hippocorpus (i.e. aiming to create exact same set of features for assessing usability and generalizability)\n"
      ],
      "metadata": {
        "id": "j1Qlb2uWxZ2k"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "#### 1. Basic features"
      ],
      "metadata": {
        "id": "5dmJPmlxrv3I"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# clean up the text\n",
        "df = df.copy()\n",
        "df[\"story_clean\"] = df[\"story\"].str.lower().str.replace(r\"[^a-z\\s]\", \"\", regex=True).str.replace(r\"\\s+\", \" \", regex=True).str.strip()\n",
        "df[\"tokens\"] = df[\"story_clean\"].str.split()\n",
        "\n",
        "# token stats\n",
        "df[\"n_tokens\"] = df[\"tokens\"].apply(len)\n",
        "df[\"n_chars\"] = df[\"story_clean\"].str.len()\n",
        "\n",
        "df[[\"label\",\"n_tokens\",\"n_chars\"]].describe().T"
      ],
