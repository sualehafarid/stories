    {
      "cell_type": "code",
      "source": [
        "def realis_density(text):\n",
        "    doc = nlp(text)\n",
        "    realis = 0\n",
        "    for token in doc:\n",
        "        if token.pos_ == \"VERB\" and token.morph.get(\"VerbForm\") == [\"Fin\"] and not any(t.tag_==\"MD\" for t in token.children):\n",
        "            realis += 1\n",
        "    return realis / len(list(doc.sents))\n",
        "\n",
        "df[\"realis_density\"] = df[\"story_clean\"].apply(realis_density)"
      ],
      "metadata": {
        "id": "pN2Q63AL16dU"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def commonsense_density(text):\n",
        "    doc = nlp(text)\n",
        "    triples = [tok for tok in doc if tok.dep_==\"ROOT\" and wn.synsets(tok.lemma_)]\n",
        "    return len(triples)/len(list(doc.sents))\n",
        "\n",
        "df[\"commonsense_density\"] = df[\"story_clean\"].apply(commonsense_density)"
      ],
      "metadata": {
        "id": "2roKHAW-19Tw"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def event_density(text):\n",
        "    doc = nlp(text)\n",
        "    verbs = [t for t in doc if t.pos_ == \"VERB\"]\n",
        "    return len(verbs) / len(list(doc.sents))\n",
        "\n",
        "df[\"event_density\"] = df[\"story_clean\"].apply(event_density)"
      ],
      "metadata": {
        "id": "sh4dqI-12G9W"
      },
      "execution_count": null,
      "outputs": []
    },
