    {
      "cell_type": "code",
      "source": [
        "# feature engineering and extraction\n",
        "\n",
        "# first define word categories that may be helpful eg modal verbs\n",
        "MODALS = {\n",
        "    \"might\",\"could\",\"maybe\",\"possibly\",\"perhaps\",\"seems\",\"seemed\",\"appear\",\"appears\",\"appeared\",\n",
        "    \"guess\",\"guessing\",\"likely\",\"unlikely\",\"probably\",\"apparently\",\"supposedly\",\"presumably\",\n",
        "    \"as\",\"like\",\"as if\"\n",
        "}\n",
        "\n",
        "# define first vs third person lists\n",
        "FIRST_PERSON = {\"i\",\"me\",\"my\",\"mine\",\"myself\"}\n",
        "THIRD_PERSON = {\"he\",\"him\",\"his\",\"she\",\"her\",\"hers\",\"they\",\"them\",\"their\",\"theirs\"}"
      ],
      "metadata": {
        "id": "j1m4ygW2z-RX"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# create modal related features\n",
        "df[\"modal\"] = df[\"tokens\"].apply(lambda x: len([w for w in x if w in MODALS]))\n",
        "df[\"modal_rate\"] = df[\"tokens\"].apply(lambda x: sum(w in MODALS for w in x) / len(x) if len(x) > 0 else 0)\n",
        "\n",
        "# get length feature\n",
        "df[\"story_length\"] = df[\"tokens\"].apply(len)\n",
        "\n",
        "# first person pronoun rate (for more personal story telling style)\n",
        "df[\"first_person_rate\"] = df[\"tokens\"].apply(lambda x: sum(w in FIRST_PERSON for w in x) / len(x) if len(x) > 0 else 0)\n",
        "\n",
        "# third person pronoun rate (for detached storytelling style)\n",
        "df[\"third_person_rate\"] = df[\"tokens\"].apply(lambda x: sum(w in THIRD_PERSON for w in x) / len(x) if len(x) > 0 else 0)\n"
      ],
      "metadata": {
        "id": "OqruEiZb1vwT"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# sentiment feature\n",
        "df[\"sentiment\"] = df[\"story\"].apply(lambda x: TextBlob(x).sentiment.polarity)\n",
        "\n",
        "# subjectivity feature: 0 = factual/objective, 1 = highly personal/opinionated (imagined or hallucinated texts are often more subjective)\n",
        "df[\"subjectivity\"] = df[\"story\"].apply(lambda x: TextBlob(x).sentiment.subjectivity)"
      ],
      "metadata": {
        "id": "dtMKRduZ0NxT"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "features = df[[\"label\", \"modal\",\"modal_rate\",\"story_length\",\"first_person_rate\",\"third_person_rate\", \"sentiment\", \"subjectivity\"]]\n",
        "\n",
        "summary = features.groupby(\"label\").agg([\"mean\",\"median\"])\n",
        "summary"
      ],
