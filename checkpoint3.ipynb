      "source": [
        "# dataset very big, sampling from it to keep a manageable size and prevent slow downs\n",
        "\n",
        "# get unique prompts\n",
        "unique_prompts = df_long[\"prompt\"].unique()\n",
        "\n",
        "# randomly sample 8000 prompts\n",
        "sampled_prompts = pd.Series(unique_prompts).sample(4000, random_state=42)\n",
        "\n",
        "# filter df_long to keep only those prompts\n",
        "df = df_long[df_long[\"prompt\"].isin(sampled_prompts)]\n",
        "\n",
        "df.info()\n"
      ],
